###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
# Generate a unique value for local/dev; never commit real production secrets.
APP_SECRET=change_this_to_a_long_random_secret_value_in_production
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> redis / cache ###
# Docker Compose (app container): redis://redis:6379
# Host machine (mapped port):     redis://127.0.0.1:63790
REDIS_DSN=redis://127.0.0.1:63790
###< redis / cache ###

###> lexik/jwt-authentication-bundle ###
# Generate RSA keys — see README "Quick start" or docs/DOCKER.md.
# Key files are gitignored; only this directory placeholder is committed.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_this_passphrase_and_match_docker_compose
###< lexik/jwt-authentication-bundle ###

###> doctrine/doctrine-bundle ###
# --- MySQL (default Docker Compose mapping: host 33060 -> container 3306) ---
DATABASE_URL="mysql://marketplace:marketplace@127.0.0.1:33060/marketplace?serverVersion=8.0&charset=utf8mb4"
# --- Inside Docker Compose network (from app service shell) ---
# DATABASE_URL="mysql://marketplace:marketplace@mysql:3306/marketplace?serverVersion=8.0&charset=utf8mb4"
# --- PostgreSQL optional profile: docker compose --profile postgres up -d postgres ---
# Then from host (port 54320):
# DATABASE_URL="postgresql://marketplace:marketplace@127.0.0.1:54320/marketplace?serverVersion=16&charset=utf8"
# --- SQLite (local quick start, no Docker DB) ---
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/marketplace.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Docker Compose (app container): redis://redis:6379/messages
# Host machine (mapped port):     redis://127.0.0.1:63790/messages
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:63790/messages
###< symfony/messenger ###
